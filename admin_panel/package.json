{
  "name": "m98-admin-panel",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "M98 董小姐音乐宇宙 · 管理后台（Vue 3 + Vite + TypeScript）",
  "scripts": {
    "predev": "node scripts/sync-assets.js",
    "dev": "vite --port 3032",
    "prebuild": "node scripts/sync-assets.js",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 3033",
    "typecheck": "vue-tsc --noEmit",
    "sync:assets": "node scripts/sync-assets.js"
  },
  "dependencies": {
    "axios": "^1.8.0",
    "pinia": "^3.0.0",
    "vue": "^3.5.0",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "typescript": "^5.8.0",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
