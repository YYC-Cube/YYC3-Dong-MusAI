{
  "name": "m98-admin-panel",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "M98 董小姐音乐宇宙 · 管理后台（Vue 3.5 + Vite 8 + TypeScript 7）",
  "scripts": {
    "predev": "node scripts/sync-assets.js",
    "dev": "vite --port 3032",
    "prebuild": "node scripts/sync-assets.js",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview --port 3033",
    "typecheck": "vue-tsc --noEmit",
    "sync:assets": "node scripts/sync-assets.js"
  },
  "dependencies": {
    "axios": "^1.21.0",
    "pinia": "^4.1.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.6",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "^7.0.2",
    "vite": "^8.3.6",
    "vue-tsc": "^3.3.14"
  },
  "engines": {
    "node": ">=20.19"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
