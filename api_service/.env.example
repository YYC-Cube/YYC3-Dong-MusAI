# M98 API Service — 环境变量示例（请勿填写真实密钥）
# 复制为 .env 后按环境填写：cp .env.example .env

# 服务器
PORT=4000
NODE_ENV=development

# 主数据库：PostgreSQL 15（唯一事实源）
PGHOST=localhost
PGPORT=5433
PGDATABASE=yyc3_music
PGUSER=yanyu
# 本机 trust/peer 免密，留空；NAS/远程由密钥管理注入
PGPASSWORD=
# 适配层 schema（与 public 既有业务表隔离）
PGSCHEMA=m98
# 远程连接是否启用 SSL
PGSSL=false
# 连接池上限
PGPOOL_MAX=10

# 测试库（npm run test:pg:setup / npm test）
PGTEST_ADMIN_DATABASE=yyc3_music
PGTEST_DATABASE=yyc3_music_test

# 遗留数据库（冻结，仅本地调试）
MONGODB_URI=mongodb://localhost:27017/m98_database
DB_PATH=../../database/m98_database.sqlite

# Redis（预留，当前未接入）
REDIS_HOST=localhost
REDIS_PORT=6379

# 前端地址（CORS 白名单，多个用英文逗号分隔）
FRONTEND_URL=http://localhost:3000

# JWT 密钥（生产环境必须由密钥管理系统注入，禁止提交真实值）
JWT_SECRET=replace-with-a-strong-random-secret
JWT_EXPIRES_IN=8h

# 管理后台账号（生产环境必须覆盖；开发默认 admin / m98-admin-dev）
ADMIN_USERNAME=admin
ADMIN_PASSWORD=m98-admin-dev

# 文件上传
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# 第三方服务（可选）
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 邮件（可选）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
