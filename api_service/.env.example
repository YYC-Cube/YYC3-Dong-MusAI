# M98 API Service — 环境变量示例（请勿填写真实密钥）
# 复制为 .env 后按环境填写：cp .env.example .env

# 服务器
PORT=4000
NODE_ENV=development

# 数据库（MongoDB 模式使用）
MONGODB_URI=mongodb://localhost:27017/m98_database

# SQLite 模式数据库路径（相对 api_service/src）
DB_PATH=../../database/m98_database.sqlite

# Redis（预留，当前未接入）
REDIS_HOST=localhost
REDIS_PORT=6379

# 前端地址（CORS 白名单，多个用英文逗号分隔）
FRONTEND_URL=http://localhost:3000

# JWT 密钥（生产环境必须由密钥管理系统注入，禁止提交真实值）
JWT_SECRET=replace-with-a-strong-random-secret

# 文件上传
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# 第三方服务（可选）
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# 邮件（可选）
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
